SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="a4cd", MODE="0666", GROUP="plugdev"
# Catch-all for any Aillio STM32 PID on the roaster cart Pi:
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", MODE="0666", GROUP="plugdev"
